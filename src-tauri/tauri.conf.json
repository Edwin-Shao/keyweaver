{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KeyWeaver",
  "version": "0.1.0",
  "identifier": "com.keyweaver.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KeyWeaver",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
